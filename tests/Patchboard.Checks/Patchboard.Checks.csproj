<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Patchboard.Checks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF strips System.IO from implicit usings. See the note in Patchboard.csproj. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Patchboard/Patchboard.csproj" />
  </ItemGroup>

</Project>
