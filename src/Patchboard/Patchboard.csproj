<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>Patchboard</AssemblyTitle>
    <Product>Patchboard</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Ship only English resources. This is safe in an ordinary build, unlike the rest of
      the publish settings, which live in Properties/PublishProfiles/win-x64.pubxml so
      that a normal build does not drag a whole self contained runtime into bin/.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded so the window and taskbar pick it up, not just the exe. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Put System.IO back into the implicit usings.

      Setting UseWPF=true pulls in Microsoft.NET.Sdk.WindowsDesktop.WPF.props, which does
      "<Using Remove="System.IO" />" at line 6. The effect is that Path, File, Directory
      and FileMode are unresolved in a WPF project even though ImplicitUsings is enabled,
      which reads as a nonsense error the first time you hit it. Restoring it here rather
      than adding a using to a dozen files keeps the reason in one place.
    -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="NAudio" Version="3.0.1" />
  </ItemGroup>

</Project>
