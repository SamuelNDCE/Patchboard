<Window x:Class="Patchboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Patchboard.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Patchboard"
        Height="780" Width="1240"
        MinHeight="480" MinWidth="860"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <vm:GridTileHeightConverter x:Key="TileHeight" />

        <!-- One device row: tick box, tag, volume, level meter -->
        <DataTemplate x:Key="DeviceRow">
            <StackPanel Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Tag}"
                               FontSize="10"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                    <CheckBox Style="{StaticResource DeviceCheck}"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsPresent}"
                              ToolTip="{Binding FriendlyName}">
                        <TextBlock Text="{Binding FriendlyName}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextBrush}" />
                    </CheckBox>
                </DockPanel>

                <Grid Margin="24,7,0,0"
                      Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Slider Style="{StaticResource ThinSlider}"
                                Value="{Binding Volume, Mode=TwoWay}" />

                        <!-- Level meter. A plain bar rather than a ProgressBar: at two
                             pixels tall the control chrome costs more than it gives. -->
                        <Border x:Name="MeterTrack"
                                Height="2"
                                Background="#1C1C1C"
                                CornerRadius="1"
                                Margin="0,4,0,0">
                            <Rectangle Fill="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Left"
                                       RadiusX="1" RadiusY="1">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource LevelToWidth}">
                                        <Binding Path="Peak" />
                                        <Binding Path="ActualWidth" ElementName="MeterTrack" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== Devices ==================== -->
            <Border Grid.Column="0"
                    Background="#0D0D0D"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,18,14,18">

                        <DockPanel Margin="0,0,0,2">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource ToolButton}"
                                    Command="{Binding RefreshDevicesCommand}"
                                    Padding="8,3"
                                    FontSize="11"
                                    Content="Refresh"
                                    ToolTip="Re-scan for audio devices" />
                            <TextBlock Style="{StaticResource PanelHeader}" Text="OUTPUT" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Hint}"
                                   Margin="0,0,0,12"
                                   Text="Tick every device that should hear the sound. Pick a virtual cable to send it into Discord or a game." />

                        <ItemsControl ItemsSource="{Binding Outputs}"
                                      ItemTemplate="{StaticResource DeviceRow}" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,18" />

                        <TextBlock Style="{StaticResource PanelHeader}" Text="INPUT" />

                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding MicEnabled, Mode=TwoWay}"
                                  Margin="0,2,0,10"
                                  AutomationProperties.Name="Mix my microphone in">
                            <TextBlock Text="Mix my microphone in" Foreground="{StaticResource TextBrush}" />
                        </CheckBox>

                        <TextBlock Style="{StaticResource Hint}"
                                   Margin="0,0,0,12"
                                   Text="Sends your voice to the same outputs as the sounds. Leave this off if VoiceMeeter already routes your mic, or people will hear you twice." />

                        <ItemsControl ItemsSource="{Binding Inputs}"
                                      ItemTemplate="{StaticResource DeviceRow}"
                                      IsEnabled="{Binding MicEnabled}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== Main ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Fixed width, not MaxWidth with Left alignment: an empty TextBox
                             sizes to its content and collapses to a small blank square. -->
                        <Grid Grid.Column="0" Width="300" HorizontalAlignment="Left">
                            <TextBox x:Name="SearchInput"
                                     Style="{StaticResource SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     ToolTip="Filter sounds by name" />
                            <TextBlock Text="Search sounds"
                                       IsHitTestVisible="False"
                                       Foreground="#5A5A5A"
                                       FontSize="12"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Master"
                                       FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Slider Style="{StaticResource ThinSlider}"
                                    Width="110"
                                    VerticalAlignment="Center"
                                    Value="{Binding MasterVolume, Mode=TwoWay}"
                                    Margin="0,0,16,0" />

                            <Button Style="{StaticResource ToolButton}"
                                    Command="{Binding AddSoundsCommand}"
                                    Content="Add sounds"
                                    Margin="0,0,8,0" />

                            <Button Style="{StaticResource DangerButton}"
                                    Command="{Binding StopAllCommand}"
                                    Content="Stop all"
                                    Margin="0,0,8,0"
                                    ToolTip="Fade out everything that is playing" />

                            <Button Style="{StaticResource ToolButton}"
                                    Command="{Binding ToggleSettingsCommand}"
                                    Content="Settings" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Button grid -->
                <ScrollViewer x:Name="GridScroller"
                              Grid.Row="1"
                              Padding="13,13,13,13"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SoundsView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Columns only, never Rows. A UniformGrid given both
                                     silently drops every item beyond rows times columns,
                                     which would hide sounds with no explanation. Tile
                                     height carries the rows setting instead. -->
                                <!-- VerticalAlignment=Top is load bearing. Left to stretch,
                                     UniformGrid divides the whole viewport height between
                                     its rows, so a short library gets tall rows with the
                                     tiles floating in the middle of them. -->
                                <UniformGrid VerticalAlignment="Top"
                                             Columns="{Binding DataContext.GridColumns,
                                                       RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SoundTile}"
                                        Command="{Binding DataContext.PlayCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        AutomationProperties.HelpText="{Binding HotkeyText}"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="OnTileMouseDown"
                                        PreviewMouseMove="OnTileMouseMove"
                                        DragOver="OnTileDragOver"
                                        Drop="OnTileDrop"
                                        Tag="{Binding DataContext,
                                              RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.Height>
                                        <MultiBinding Converter="{StaticResource TileHeight}">
                                            <Binding Path="ViewportHeight" ElementName="GridScroller" />
                                            <Binding Path="DataContext.GridRows"
                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </Button.Height>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename"
                                                      Command="{Binding PlacementTarget.Tag.RenameCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="Set hotkey"
                                                      Command="{Binding PlacementTarget.Tag.BeginBindHotkeyCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Clear hotkey"
                                                      Command="{Binding PlacementTarget.Tag.ClearHotkeyCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="Set image"
                                                      Command="{Binding PlacementTarget.Tag.SetImageCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Clear image"
                                                      Command="{Binding PlacementTarget.Tag.ClearImageCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="Remove"
                                                      Command="{Binding PlacementTarget.Tag.RemoveSoundCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state, shown over the grid when there is nothing bound -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sounds.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Drop audio files here"
                               FontSize="15"
                               Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="or use Add sounds, or import your Resanance library from Settings"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Status bar -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <TextBlock Text="{Binding Status}"
                               FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== Settings ==================== -->
        <Border Background="#CC000000"
                Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="440"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Settings"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,20" />

                    <TextBlock Style="{StaticResource PanelHeader}" Text="GRID" />

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Columns" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource StepButton}" Content="-"
                                    Command="{Binding ColumnsDownCommand}" />
                            <TextBlock Text="{Binding GridColumns}" Width="34"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontSize="13" />
                            <Button Style="{StaticResource StepButton}" Content="+"
                                    Command="{Binding ColumnsUpCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Rows visible" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource StepButton}" Content="-"
                                    Command="{Binding RowsDownCommand}" />
                            <TextBlock Text="{Binding GridRows}" Width="34"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontSize="13" />
                            <Button Style="{StaticResource StepButton}" Content="+"
                                    Command="{Binding RowsUpCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}"
                               Margin="0,0,0,20"
                               Text="Rows sets how many fit on screen. Anything past that scrolls, so no sound is ever hidden." />

                    <TextBlock Style="{StaticResource PanelHeader}" Text="LIBRARY" />

                    <Button Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Command="{Binding ImportResananceCommand}"
                            Content="Import from Resanance" />

                    <Button Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,20"
                            Command="{Binding ImportFolderCommand}"
                            Content="Import a folder of sounds" />

                    <TextBlock Style="{StaticResource PanelHeader}" Text="AUDIO" />

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Buffer" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding LatencyMs}" Width="34"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontSize="13" />
                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Slider Style="{StaticResource ThinSlider}"
                            Minimum="20" Maximum="200"
                            Value="{Binding LatencyMs, Mode=TwoWay}"
                            Margin="0,0,0,6" />

                    <TextBlock Style="{StaticResource Hint}"
                               Margin="0,0,0,22"
                               Text="Lower is snappier. Too low and audio crackles on a busy machine. Changing this reopens the outputs." />

                    <Button Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleSettingsCommand}"
                            Content="Done" />
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== Rename ==================== -->
        <Border Background="#CC000000"
                IsVisibleChanged="OnRenameVisibleChanged"
                Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Rename button"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,4" />

                    <TextBlock Text="{Binding RenameSubject}"
                               Style="{StaticResource Hint}"
                               Margin="0,0,0,14" />

                    <TextBox x:Name="RenameBox"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             KeyDown="OnRenameKeyDown" />

                    <TextBlock Style="{StaticResource Hint}"
                               Margin="0,10,0,18"
                               Text="Leave it empty to go back to the file name. Enter to save, Escape to cancel." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ToolButton}"
                                Content="Cancel"
                                Margin="0,0,8,0"
                                Command="{Binding CancelRenameCommand}" />
                        <Button Style="{StaticResource ToolButton}"
                                Content="Save"
                                Command="{Binding ConfirmRenameCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== Hotkey capture ==================== -->
        <Border Background="#E6000000"
                Visibility="{Binding IsBindingHotkey, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Press a key combination"
                           FontSize="18"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Escape to cancel"
                           FontSize="12"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
