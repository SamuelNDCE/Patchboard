<Window x:Class="Patchboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Patchboard.ViewModels"
        Title="Patchboard"
        Icon="app.ico"
        Height="780" Width="1240"
        MinHeight="480" MinWidth="860"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <vm:GridTileHeightConverter x:Key="TileHeight" />

        <!-- One device row: tick box, tag, volume, level meter -->
        <DataTemplate x:Key="DeviceRow">
            <StackPanel Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Tag}"
                               FontSize="10"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}" />
                    <CheckBox Style="{StaticResource DeviceCheck}"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsPresent}"
                              ToolTip="{Binding FriendlyName}">
                        <TextBlock Text="{Binding FriendlyName}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextBrush}" />
                    </CheckBox>
                </DockPanel>

                <Grid Margin="24,7,0,0"
                      Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- The number matters. A slider alone hid a device sitting at 6%,
                             which looked exactly like a routing failure. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0"
                                    Style="{StaticResource ThinSlider}"
                                    Value="{Binding Volume, Mode=TwoWay}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Volume, StringFormat={}{0:P0}}"
                                       FontSize="10"
                                       Width="34"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                        <Style.Triggers>
                                            <!-- Turned down far enough to be mistaken for broken. -->
                                            <DataTrigger Binding="{Binding IsQuiet}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Mark one output as "my headphones". Right clicking a sound then
                             offers to play it here alone, so it can be checked without
                             going out to everyone. -->
                        <CheckBox Style="{StaticResource DeviceCheck}"
                                  Margin="0,7,0,0"
                                  IsChecked="{Binding IsMonitor, Mode=TwoWay}"
                                  Visibility="{Binding IsOutput, Converter={StaticResource BoolToVis}}"
                                  AutomationProperties.Name="{Binding FriendlyName, StringFormat='Use {0} as my headphones'}"
                                  ToolTip="Previews play here only, not to the other devices">
                            <TextBlock Text="these are my headphones"
                                       FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}" />
                        </CheckBox>

                        <!-- Send the mic here too. Output rows only, and only while
                             passthrough is on. Off by default on every device, because
                             the mic reaching anything audible is what causes feedback. -->
                        <StackPanel Margin="0,7,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsOutput}" Value="True" />
                                                <Condition Binding="{Binding DataContext.MicEnabled,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <CheckBox Style="{StaticResource DeviceCheck}"
                                      IsChecked="{Binding ReceivesMic, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding FriendlyName, StringFormat='Send my mic to {0}'}">
                                <TextBlock Text="send my mic here"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" />
                            </CheckBox>

                            <TextBlock Text="{Binding FeedbackRisk}"
                                       FontSize="10"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="24,3,0,0"
                                       Visibility="{Binding HasFeedbackRisk, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Half a route is silent. Say what the other end must be set to. -->
                        <TextBlock Text="{Binding ListenHint}"
                                   FontSize="10"
                                   Foreground="#7A7A7A"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"
                                   Visibility="{Binding HasListenHint, Converter={StaticResource BoolToVis}}" />

                        <!-- Level meter. A plain bar rather than a ProgressBar: at two
                             pixels tall the control chrome costs more than it gives. -->
                        <Border x:Name="MeterTrack"
                                Height="2"
                                Background="#1C1C1C"
                                CornerRadius="1"
                                Margin="0,4,0,0">
                            <Rectangle Fill="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Left"
                                       RadiusX="1" RadiusY="1">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource LevelToWidth}">
                                        <Binding Path="Peak" />
                                        <Binding Path="ActualWidth" ElementName="MeterTrack" />
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== Devices ==================== -->
            <Border Grid.Column="0"
                    Background="#0D0D0D"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,18,14,18">

                        <DockPanel Margin="0,0,0,2">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource ToolButton}"
                                    Command="{Binding RefreshDevicesCommand}"
                                    Padding="8,3"
                                    FontSize="11"
                                    Content="Refresh"
                                    ToolTip="Re-scan for audio devices" />
                            <TextBlock Style="{StaticResource PanelHeader}" Text="OUTPUT" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource Hint}"
                                   Margin="0,0,0,12"
                                   Text="Tick every device that should hear the sound. Pick a virtual cable to send it into Discord or a game." />

                        <ItemsControl ItemsSource="{Binding Outputs}"
                                      ItemTemplate="{StaticResource DeviceRow}" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,18" />

                        <TextBlock Style="{StaticResource PanelHeader}" Text="INPUT" />

                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding MicEnabled, Mode=TwoWay}"
                                  Margin="0,2,0,10"
                                  AutomationProperties.Name="Mix my microphone in">
                            <TextBlock Text="Mix my microphone in" Foreground="{StaticResource TextBrush}" />
                        </CheckBox>

                        <TextBlock Style="{StaticResource Hint}"
                                   Margin="0,0,0,12"
                                   Text="Sends your voice to the same outputs as the sounds. Leave this off if VoiceMeeter already routes your mic, or people will hear you twice." />

                        <!-- Dimmed when passthrough is off, never disabled. Disabling the
                             rows made it impossible to untick a microphone after turning
                             the mic off, so a bad selection stayed in the config and came
                             straight back the moment passthrough was switched on again. -->
                        <ItemsControl ItemsSource="{Binding Inputs}"
                                      ItemTemplate="{StaticResource DeviceRow}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.MicEnabled,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="False">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== Main ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />   <!-- transport, when something plays -->
                    <RowDefinition Height="Auto" />   <!-- status strip -->
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <!-- The app never said its own name anywhere in the window.
                                 A title bar caption is not enough: people screenshot this
                                 and stream it, and nothing in the picture said what it was. -->
                            <TextBlock Text="PATCHBOARD"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,20,0" />

                        <!-- Fixed width, not MaxWidth with Left alignment: an empty TextBox
                             sizes to its content and collapses to a small blank square. -->
                        <Grid Width="300">
                            <TextBox x:Name="SearchInput"
                                     Style="{StaticResource SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     ToolTip="Filter sounds by name" />
                            <TextBlock Text="Search sounds"
                                       IsHitTestVisible="False"
                                       Foreground="#5A5A5A"
                                       FontSize="12"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Master"
                                       FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Slider Style="{StaticResource ThinSlider}"
                                    Width="110"
                                    VerticalAlignment="Center"
                                    Value="{Binding MasterVolume, Mode=TwoWay}"
                                    Margin="0,0,16,0" />

                            <Button Style="{StaticResource ToolButton}"
                                    Command="{Binding AddSoundsCommand}"
                                    Content="Add sounds"
                                    Margin="0,0,8,0" />

                            <!-- The panic button. Feedback gets loud fast, and hunting for
                                 the right checkbox while it howls is not reasonable. -->
                            <Button Style="{StaticResource DangerButton}"
                                    Command="{Binding MuteMicCommand}"
                                    Content="Mute mic"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding MicIsLive, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Stop sending your microphone anywhere, right now" />

                            <Button Style="{StaticResource DangerButton}"
                                    Command="{Binding StopAllCommand}"
                                    Content="Stop all"
                                    Margin="0,0,8,0"
                                    ToolTip="Fade out everything that is playing" />

                            <Button Style="{StaticResource ToolButton}"
                                    Command="{Binding ToggleSettingsCommand}"
                                    Content="Settings" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- A direct electrical loop, distinct from acoustic feedback: the mic is
                     going into one end of a cable that is also being recorded. -->
                <Border Grid.Row="1"
                        Background="#1A0F0F"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12"
                        Panel.ZIndex="2"
                        Visibility="{Binding HasLoopWarning, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LoopWarning}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding MuteMicCommand}"
                                Content="Mute mic"
                                Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- Nothing ticked in the output panel. Pressing a button would be silent,
                     and a line in the status bar was demonstrably too quiet to notice. -->
                <Border Grid.Row="1"
                        Background="#1A0F0F"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12"
                        Visibility="{Binding HasNoOutput, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="No output selected, so nothing will play"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="Tick a device under OUTPUT on the left, or use a shortcut. You can pick several at once."
                                       Style="{StaticResource Hint}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}"
                                    Margin="0,0,8,0"
                                    Command="{Binding UseDefaultOutputCommand}"
                                    Visibility="{Binding HasDefaultOutput, Converter={StaticResource BoolToVis}}"
                                    Content="{Binding DefaultOutputName, StringFormat='Play on {0}'}"
                                    ToolTip="Your Windows default playback device" />

                            <Button Style="{StaticResource ToolButton}"
                                    Command="{Binding UseCableOutputCommand}"
                                    Visibility="{Binding HasCableOutput, Converter={StaticResource BoolToVis}}"
                                    Content="Send to Discord"
                                    ToolTip="{Binding VoiceRouteName, StringFormat='Routes through {0}. Check what Discord is listening on.'}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Ticked, but only local hardware, so nobody on the other end hears it.
                     A different failure from having nothing ticked, and the one that has
                     actually bitten twice. Amber rather than red: the app is working, the
                     routing just does not leave this machine. -->
                <Border Grid.Row="1"
                        Background="#1A140A"
                        BorderBrush="#5A4A1A"
                        BorderThickness="1"
                        CornerRadius="9"
                        Margin="13,13,13,0"
                        Padding="16,12"
                        Visibility="{Binding OnlyLocalOutput, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="No virtual cable selected"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E0B341" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding LocalOutputNames, StringFormat='Patchboard is only playing to real hardware ({0}). If nobody else can hear you, add a virtual cable. If they can, something outside this app is carrying it: a Voicemeeter bus, or your mic picking up the room.'}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolButton}"
                                    Margin="0,0,8,0"
                                    Command="{Binding UseCableOutputCommand}"
                                    Visibility="{Binding HasCableOutput, Converter={StaticResource BoolToVis}}"
                                    Content="Add a cable"
                                    ToolTip="{Binding VoiceRouteName, StringFormat='Adds {0}. Check that Discord is listening on it.'}" />

                            <Button Style="{StaticResource ToolButton}"
                                    Command="{Binding DismissRoutingNoticeCommand}"
                                    Content="I know"
                                    ToolTip="Hide this for now. It comes back if you change the output selection." />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Button grid -->
                <ScrollViewer x:Name="GridScroller"
                              Grid.Row="2"
                              Padding="13,13,13,13"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SoundsView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Columns only, never Rows. A UniformGrid given both
                                     silently drops every item beyond rows times columns,
                                     which would hide sounds with no explanation. Tile
                                     height carries the rows setting instead. -->
                                <!-- VerticalAlignment=Top is load bearing. Left to stretch,
                                     UniformGrid divides the whole viewport height between
                                     its rows, so a short library gets tall rows with the
                                     tiles floating in the middle of them. -->
                                <UniformGrid VerticalAlignment="Top"
                                             Columns="{Binding DataContext.GridColumns,
                                                       RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SoundTile}"
                                        Command="{Binding DataContext.PlayCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        AutomationProperties.HelpText="{Binding HotkeyText}"
                                        AllowDrop="True"
                                        ContextMenuOpening="OnTileContextMenuOpening"
                                        PreviewMouseLeftButtonDown="OnTileMouseDown"
                                        PreviewMouseMove="OnTileMouseMove"
                                        DragOver="OnTileDragOver"
                                        Drop="OnTileDrop"
                                        Tag="{Binding DataContext,
                                              RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.Height>
                                        <MultiBinding Converter="{StaticResource TileHeight}">
                                            <Binding Path="ViewportHeight" ElementName="GridScroller" />
                                            <Binding Path="DataContext.GridRows"
                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </Button.Height>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <!-- Name of the sound the menu is acting on, which
                                                 matters when tiles are small and the labels clip. -->
                                            <MenuItem Style="{StaticResource MenuHeaderItem}"
                                                      Header="{Binding DisplayName}" />

                                            <!-- Volume lives inline rather than behind a submenu:
                                                 the slider, the readout and the preview are one
                                                 thing you use together, and a submenu made you
                                                 hover to reach a control you then had to drag. -->
                                            <MenuItem Style="{StaticResource MenuPanelItem}" StaysOpenOnClick="True">
                                                <MenuItem.Header>
                                                    <StackPanel Width="196">
                                                        <Grid Margin="0,0,0,5">
                                                            <TextBlock Text="Volume"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextDimBrush}" />
                                                            <TextBlock Text="{Binding VolumeText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsBoosted}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Slider Style="{StaticResource ThinSlider}"
                                                                Minimum="0" Maximum="2"
                                                                SmallChange="0.05" LargeChange="0.1"
                                                                Value="{Binding Volume, Mode=TwoWay}" />

                                                        <Grid Margin="0,2,0,8">
                                                            <TextBlock Text="0" FontSize="9"
                                                                       Foreground="#5A5A5A" HorizontalAlignment="Left" />
                                                            <TextBlock Text="100" FontSize="9"
                                                                       Foreground="#5A5A5A" HorizontalAlignment="Center" />
                                                            <TextBlock Text="200" FontSize="9"
                                                                       Foreground="#5A5A5A" HorizontalAlignment="Right" />
                                                        </Grid>

                                                        <TextBlock Text="Boosted, may clip"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource DangerBrush}"
                                                                   Margin="0,0,0,7"
                                                                   Visibility="{Binding IsBoosted, Converter={StaticResource BoolToVis}}" />

                                                        <Button Style="{StaticResource ToolButton}"
                                                                Content="Preview in my headphones"
                                                                FontSize="11"
                                                                Padding="6,6"
                                                                Command="{Binding PreviewCommand}" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>

                                            <!-- Trim, as sliders over the real clip length.
                                                 Typed offsets were the first attempt and were
                                                 the wrong shape: naming a millisecond means
                                                 already knowing where the moment is, which is
                                                 the thing you were trying to find. The length
                                                 is read off the file when the menu opens, so
                                                 the sliders have something to aim along. -->
                                            <MenuItem Style="{StaticResource MenuPanelItem}" StaysOpenOnClick="True">
                                                <MenuItem.Header>
                                                    <StackPanel Width="196">
                                                        <Grid Margin="0,0,0,5">
                                                            <TextBlock Text="Trim"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextDimBrush}" />
                                                            <TextBlock Text="{Binding DurationText}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextDimBrush}"
                                                                       HorizontalAlignment="Right" />
                                                        </Grid>

                                                        <StackPanel IsEnabled="{Binding HasDuration}">
                                                            <TextBlock Text="Start" FontSize="9"
                                                                       Foreground="#5A5A5A" Margin="0,0,0,1" />
                                                            <Slider Style="{StaticResource ThinSlider}"
                                                                    Minimum="0"
                                                                    Maximum="{Binding DurationSeconds}"
                                                                    SmallChange="0.1" LargeChange="1"
                                                                    Value="{Binding StartSeconds, Mode=TwoWay}" />

                                                            <TextBlock Text="End" FontSize="9"
                                                                       Foreground="#5A5A5A" Margin="0,6,0,1" />
                                                            <Slider Style="{StaticResource ThinSlider}"
                                                                    Minimum="0"
                                                                    Maximum="{Binding DurationSeconds}"
                                                                    SmallChange="0.1" LargeChange="1"
                                                                    Value="{Binding EndSeconds, Mode=TwoWay}" />
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding TrimText}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextDimBrush}"
                                                                   Margin="0,6,0,0"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <Button Style="{StaticResource ToolButton}"
                                                                Content="Use the whole clip"
                                                                FontSize="11"
                                                                Padding="6,5"
                                                                Margin="0,6,0,0"
                                                                Command="{Binding ClearTrimCommand}"
                                                                Visibility="{Binding IsTrimmed,
                                                                            Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>

                                            <!-- Colour, inline for the same reason volume is:
                                                 you pick by looking, so the choices have to be
                                                 visible rather than behind a hover. Eight tints
                                                 rather than a full picker, because a soundboard
                                                 needs tiles that are quick to tell apart, not
                                                 sixteen million shades to choose between. -->
                                            <MenuItem Style="{StaticResource MenuPanelItem}" StaysOpenOnClick="True">
                                                <MenuItem.Header>
                                                    <StackPanel Width="196">
                                                        <TextBlock Text="Colour"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextDimBrush}"
                                                                   Margin="0,0,0,6" />
                                                        <WrapPanel>
                                                            <Button Width="20" Height="20" Margin="0,0,4,4"
                                                                    Style="{StaticResource Swatch}"
                                                                    Background="#3A1F1F"
                                                                    ToolTip="Red"
                                                                    Command="{Binding SetColorCommand}"
                                                                    CommandParameter="#3A1F1F" />
                                                            <Button Width="20" Height="20" Margin="0,0,4,4"
                                                                    Style="{StaticResource Swatch}"
                                                                    Background="#3A2A15"
                                                                    ToolTip="Amber"
                                                                    Command="{Binding SetColorCommand}"
                                                                    CommandParameter="#3A2A15" />
                                                            <Button Width="20" Height="20" Margin="0,0,4,4"
                                                                    Style="{StaticResource Swatch}"
                                                                    Background="#2A331B"
                                                                    ToolTip="Olive"
                                                                    Command="{Binding SetColorCommand}"
                                                                    CommandParameter="#2A331B" />
                                                            <Button Width="20" Height="20" Margin="0,0,4,4"
                                                                    Style="{StaticResource Swatch}"
                                                                    Background="#153331"
                                                                    ToolTip="Teal"
                                                                    Command="{Binding SetColorCommand}"
                                                                    CommandParameter="#153331" />
                                                            <Button Width="20" Height="20" Margin="0,0,4,4"
                                                                    Style="{StaticResource Swatch}"
                                                                    Background="#1B2A3E"
                                                                    ToolTip="Blue"
                                                                    Command="{Binding SetColorCommand}"
                                                                    CommandParameter="#1B2A3E" />
                                                            <Button Width="20" Height="20" Margin="0,0,4,4"
                                                                    Style="{StaticResource Swatch}"
                                                                    Background="#2C2140"
                                                                    ToolTip="Purple"
                                                                    Command="{Binding SetColorCommand}"
                                                                    CommandParameter="#2C2140" />
                                                            <Button Width="20" Height="20" Margin="0,0,4,4"
                                                                    Style="{StaticResource Swatch}"
                                                                    Background="#3A1F30"
                                                                    ToolTip="Pink"
                                                                    Command="{Binding SetColorCommand}"
                                                                    CommandParameter="#3A1F30" />
                                                            <Button Width="20" Height="20" Margin="0,0,4,4"
                                                                    Style="{StaticResource Swatch}"
                                                                    Background="#2E2E2E"
                                                                    ToolTip="Grey"
                                                                    Command="{Binding SetColorCommand}"
                                                                    CommandParameter="#2E2E2E" />
                                                            <Button Width="20" Height="20" Margin="0,0,4,4"
                                                                    Style="{StaticResource Swatch}"
                                                                    Background="{StaticResource SurfaceBrush}"
                                                                    ToolTip="No colour"
                                                                    Command="{Binding SetColorCommand}"
                                                                    CommandParameter="" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>

                                            <!-- Groups are separated by spacing rather than rules.
                                                 A line sitting under a label reads as underlining
                                                 that label rather than dividing the group. -->
                                            <MenuItem Header="Rename"
                                                      Style="{StaticResource MenuGroupStart}"
                                                      Command="{Binding PlacementTarget.Tag.RenameCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Set image"
                                                      Command="{Binding PlacementTarget.Tag.SetImageCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Clear image"
                                                      Command="{Binding PlacementTarget.Tag.ClearImageCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                            <MenuItem Header="Set hotkey"
                                                      Style="{StaticResource MenuGroupStart}"
                                                      Command="{Binding PlacementTarget.Tag.BeginBindHotkeyCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Clear hotkey"
                                                      Command="{Binding PlacementTarget.Tag.ClearHotkeyCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                            <MenuItem Header="Remove"
                                                      Style="{StaticResource MenuDangerItem}"
                                                      Command="{Binding PlacementTarget.Tag.RemoveSoundCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state, shown over the grid when there is nothing bound -->
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sounds.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Drop audio files here"
                               FontSize="15"
                               Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="or use Add sounds, or import a whole folder from Settings"
                               FontSize="11"
                               Foreground="#5A5A5A"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Status bar -->
                <Border Grid.Row="3"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Status}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <!-- Now playing, with a seek bar.
                     Sitting above the status strip rather than on the tile, because it is
                     about one sound at a time and a tile is 90 pixels wide. Dragging it
                     moves every device's copy together: they are one sound to a listener,
                     and letting them drift would put an echo on it. -->
                <Border Grid.Row="4"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="13,8"
                        Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding CurrentName}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,14,0" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentPositionText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"
                                   Width="46"
                                   TextAlignment="Right"
                                   Margin="0,0,10,0" />

                        <Slider Grid.Column="2"
                                Style="{StaticResource ThinSlider}"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="{Binding CurrentDuration}"
                                Value="{Binding CurrentPosition, Mode=TwoWay}"
                                Thumb.DragStarted="OnSeekStarted"
                                Thumb.DragCompleted="OnSeekFinished"
                                ToolTip="Drag to skip through the clip" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding CurrentDurationText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"
                                   Width="46"
                                   Margin="10,0,10,0" />

                        <Button Grid.Column="4"
                                Style="{StaticResource ToolButton}"
                                Padding="10,4"
                                FontSize="11"
                                Command="{Binding StopAllCommand}"
                                Content="Stop" />
                    </Grid>
                </Border>

                <!-- His voice is going out wherever the sounds go. If that includes
                             his headphones he will hear himself, and if VoiceMeeter already
                             routes the mic he goes out twice. -->
                        <Border Grid.Column="1"
                                Background="#14241A"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3"
                                Visibility="{Binding MicIsLive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="MIC LIVE"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== Settings ==================== -->
        <Border Background="#CC000000"
                Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="440"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Settings"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,20" />

                    <TextBlock Style="{StaticResource PanelHeader}" Text="GRID" />

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Columns" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource StepButton}" Content="-"
                                    Command="{Binding ColumnsDownCommand}" />
                            <TextBlock Text="{Binding GridColumns}" Width="34"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontSize="13" />
                            <Button Style="{StaticResource StepButton}" Content="+"
                                    Command="{Binding ColumnsUpCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Rows visible" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource StepButton}" Content="-"
                                    Command="{Binding RowsDownCommand}" />
                            <TextBlock Text="{Binding GridRows}" Width="34"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontSize="13" />
                            <Button Style="{StaticResource StepButton}" Content="+"
                                    Command="{Binding RowsUpCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Hint}"
                               Margin="0,0,0,20"
                               Text="Rows sets how many fit on screen. Anything past that scrolls, so no sound is ever hidden." />

                    <TextBlock Style="{StaticResource PanelHeader}" Text="LIBRARY" />

                    <Button Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Command="{Binding ImportFolderCommand}"
                            Content="Import a folder of sounds" />

                    <!-- Cleanup for a library that arrived by the hundred. Each one asks
                         first and names the count; none of them deletes an audio file. -->
                    <Button Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Command="{Binding TidyNamesCommand}"
                            Content="Tidy up labels"
                            ToolTip="Strips download leftovers like (1), site prefixes and id suffixes. Leaves anything you renamed yourself alone." />

                    <Button Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Command="{Binding RemoveDuplicatesCommand}"
                            Content="Remove duplicate sounds"
                            ToolTip="Finds buttons pointing at byte identical audio and keeps one of each." />

                    <Button Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,20"
                            Command="{Binding RemoveDeadCommand}"
                            Content="Remove buttons with missing files"
                            ToolTip="Clears out buttons whose audio file is no longer on disk." />

                    <TextBlock Style="{StaticResource PanelHeader}" Text="AUDIO" />

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Buffer" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding LatencyMs}" Width="34"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontSize="13" />
                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Slider Style="{StaticResource ThinSlider}"
                            Minimum="20" Maximum="200"
                            Value="{Binding LatencyMs, Mode=TwoWay}"
                            Margin="0,0,0,6" />

                    <TextBlock Style="{StaticResource Hint}"
                               Margin="0,0,0,22"
                               Text="Lower is snappier. Too low and audio crackles on a busy machine. Changing this reopens the outputs." />

                    <Button Style="{StaticResource ToolButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding ToggleSettingsCommand}"
                            Content="Done" />
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== Rename ==================== -->
        <Border Background="#CC000000"
                IsVisibleChanged="OnRenameVisibleChanged"
                Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Rename button"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,4" />

                    <TextBlock Text="{Binding RenameSubject}"
                               Style="{StaticResource Hint}"
                               Margin="0,0,0,14" />

                    <TextBox x:Name="RenameBox"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             KeyDown="OnRenameKeyDown" />

                    <TextBlock Style="{StaticResource Hint}"
                               Margin="0,10,0,18"
                               Text="Leave it empty to go back to the file name. Enter to save, Escape to cancel." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ToolButton}"
                                Content="Cancel"
                                Margin="0,0,8,0"
                                Command="{Binding CancelRenameCommand}" />
                        <Button Style="{StaticResource ToolButton}"
                                Content="Save"
                                Command="{Binding ConfirmRenameCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== Hotkey capture ==================== -->
        <Border Background="#E6000000"
                Visibility="{Binding IsBindingHotkey, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Press a key combination"
                           FontSize="18"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Escape to cancel"
                           FontSize="12"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
