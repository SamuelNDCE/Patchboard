<?xml version="1.0" encoding="utf-8"?>
<!--
  The release build, as one file anyone can download and run.

    dotnet publish src/Patchboard/Patchboard.csproj -p:PublishProfile=win-x64 -o publish

  These settings live in a profile rather than in the csproj on purpose. SelfContained and
  RuntimeIdentifier in the project file would drag the whole .NET runtime into bin/ on
  every ordinary build and slow the check suite down for no reason.

  Self contained is deliberate: it means no .NET install is needed to run it.

  Compression is what makes that affordable. Measured on this project, the identical build
  is 156MB without it and 68MB with, in exchange for a one-off decompression at startup.

  Two things deliberately NOT set:
    InvariantGlobalization  measured at exactly the same 68MB, so it would trade away
                            culture-aware string handling for nothing.
    PublishTrimmed          not supported for WPF. It builds and then fails at runtime
                            when XAML reflects over a type the trimmer removed.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
